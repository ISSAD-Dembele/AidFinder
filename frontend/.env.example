# Port du backend si VITE_API_URL n'est pas défini.
# L'URL de l'API est déduite automatiquement du navigateur :
#   - PC : http://localhost:8000
#   - Téléphone/tablette (réseau local) : http://<IP-du-PC>:8000
VITE_API_PORT=8000

# Surcharge optionnelle de l'URL complète de l'API.
# ⚠️  Ne pas utiliser localhost/127.0.0.1 si vous testez depuis un téléphone :
#     sur mobile, localhost désigne l'appareil, pas le PC serveur.
# VITE_API_URL=http://192.168.1.42:8000
